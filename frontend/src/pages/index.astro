---
import Layout from '../layouts/Layout.astro';
---

<Layout title="goDnsBench - DNS Benchmarking Tool">
	<div id="app" class="min-h-screen flex flex-col">
		<!-- Header -->
		<header class="bg-light-gray border-b border-lighter-gray px-6 py-4">
			<div class="flex items-center justify-between">
				<div class="flex items-center space-x-3">
					<h1 class="text-2xl font-bold text-electric-blue">goDnsBench</h1>
					<span class="text-sm text-gray-400">DNS Benchmarking Tool</span>
				</div>
				<div class="flex items-center space-x-4">
					<button id="settings-btn" class="px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition">
						Settings
					</button>
				</div>
			</div>
		</header>

		<!-- Main Content -->
		<main class="flex-1 flex">
			<!-- Sidebar -->
			<aside class="w-80 bg-light-gray border-r border-lighter-gray p-6 overflow-y-auto">
				<div class="space-y-6">
					<!-- Protocol Selection -->
					<div>
						<h2 class="text-lg font-bold text-neon-cyan mb-3">Protocols</h2>
						<div class="space-y-2">
							<label class="flex items-center space-x-2 cursor-pointer">
								<input type="checkbox" id="protocol-dns" checked class="form-checkbox text-electric-blue">
								<span>DNS (UDP/TCP)</span>
							</label>
							<label class="flex items-center space-x-2 cursor-pointer">
								<input type="checkbox" id="protocol-doh" checked class="form-checkbox text-electric-blue">
								<span>DoH (HTTPS)</span>
							</label>
							<label class="flex items-center space-x-2 cursor-pointer">
								<input type="checkbox" id="protocol-dot" checked class="form-checkbox text-electric-blue">
								<span>DoT (TLS)</span>
							</label>
							<label class="flex items-center space-x-2 cursor-pointer">
								<input type="checkbox" id="protocol-doq" checked class="form-checkbox text-electric-blue">
								<span>DoQ (QUIC)</span>
							</label>
						</div>
					</div>

					<!-- Server List -->
					<div>
						<div class="flex items-center justify-between mb-3">
							<h2 class="text-lg font-bold text-neon-cyan">DNS Servers</h2>
							<button id="refresh-servers-btn" class="text-sm text-electric-blue hover:text-neon-cyan">
								Refresh
							</button>
						</div>
						<div id="server-list" class="space-y-1 max-h-96 overflow-y-auto">
							<!-- Server items will be populated here -->
						</div>
						<div class="mt-3 space-y-2">
							<button id="add-server-btn" class="w-full px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition text-sm">
								+ Add Server
							</button>
							<button id="import-btn" class="w-full px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition text-sm">
								Import from File
							</button>
						</div>
					</div>

					<!-- Run Benchmark Button -->
					<button id="run-benchmark-btn" class="w-full px-6 py-3 bg-electric-blue hover:bg-neon-cyan text-white font-bold rounded-lg transition shadow-lg">
						Run Benchmark
					</button>
				</div>
			</aside>

			<!-- Results Area -->
			<div class="flex-1 p-6 overflow-y-auto">
				<div id="results-container" class="hidden">
					<!-- Progress -->
					<div id="progress-container" class="hidden mb-6">
						<div class="bg-light-gray rounded-lg p-6">
							<h3 class="text-lg font-bold text-neon-cyan mb-4">Running Benchmark...</h3>
							<div class="space-y-3">
								<div class="flex justify-between text-sm">
									<span id="current-server">Testing...</span>
									<span id="progress-percentage">0%</span>
								</div>
								<div class="w-full bg-dark-gray rounded-full h-4 overflow-hidden">
									<div id="progress-bar" class="bg-electric-blue h-full transition-all duration-300" style="width: 0%"></div>
								</div>
							</div>
						</div>
					</div>

					<!-- Results Table -->
					<div id="results-table-container" class="hidden mb-6">
						<div class="flex items-center justify-between mb-4">
							<h3 class="text-lg font-bold text-neon-cyan">Results</h3>
							<div class="flex space-x-2">
								<button id="filter-btn" class="px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition text-sm">
									Filter
								</button>
								<button id="export-json-btn" class="px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition text-sm">
									Export JSON
								</button>
								<button id="export-csv-btn" class="px-4 py-2 bg-lighter-gray hover:bg-electric-blue rounded transition text-sm">
									Export CSV
								</button>
							</div>
						</div>
						
						<!-- Filter Panel -->
						<div id="filter-panel" class="hidden bg-light-gray rounded-lg p-4 mb-4">
							<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
								<div>
									<label class="block text-xs text-gray-400 mb-1">Server Name</label>
									<input type="text" id="filter-server" placeholder="Filter by server..." class="w-full px-3 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm">
								</div>
								<div>
									<label class="block text-xs text-gray-400 mb-1">Protocol</label>
									<select id="filter-protocol" class="w-full px-3 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm">
										<option value="">All Protocols</option>
										<option value="DNS">DNS</option>
										<option value="DoH">DoH</option>
										<option value="DoT">DoT</option>
										<option value="DoQ">DoQ</option>
									</select>
								</div>
								<div>
									<label class="block text-xs text-gray-400 mb-1">Min Success Rate (%)</label>
									<input type="number" id="filter-success-rate" min="0" max="100" placeholder="0" class="w-full px-3 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm">
								</div>
							</div>
							<div class="flex justify-end mt-4">
								<button id="clear-filters-btn" class="px-4 py-2 bg-lighter-gray hover:bg-gray-600 rounded transition text-sm mr-2">
									Clear
								</button>
								<button id="apply-filters-btn" class="px-4 py-2 bg-electric-blue hover:bg-neon-cyan rounded transition text-sm">
									Apply
								</button>
							</div>
						</div>
						
						<div class="bg-light-gray rounded-lg overflow-hidden">
							<table class="w-full">
								<thead class="bg-lighter-gray">
									<tr>
										<th class="px-4 py-3 text-left text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="server">Server ↕️</th>
										<th class="px-4 py-3 text-left text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="protocol">Protocol ↕️</th>
										<th class="px-4 py-3 text-right text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="min">Min (ms) ↕️</th>
										<th class="px-4 py-3 text-right text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="mean">Mean (ms) ↕️</th>
										<th class="px-4 py-3 text-right text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="p95">P95 (ms) ↕️</th>
										<th class="px-4 py-3 text-right text-sm font-semibold cursor-pointer hover:bg-lighter-gray/50" data-sort="successRate">Success Rate ↕️</th>
									</tr>
								</thead>
								<tbody id="results-tbody">
									<!-- Results will be populated here -->
								</tbody>
							</table>
						</div>
					</div>

					<!-- Visualization Charts -->
					<div id="charts-container" class="hidden">
						<h3 class="text-lg font-bold text-neon-cyan mb-4">Visualization</h3>
						<div class="grid grid-cols-1 gap-6">
							<div class="bg-light-gray rounded-lg p-6">
								<h4 class="text-sm font-semibold mb-4 text-gray-300">Mean Latency Comparison</h4>
								<canvas id="latency-chart"></canvas>
							</div>
							<div class="bg-light-gray rounded-lg p-6">
								<h4 class="text-sm font-semibold mb-4 text-gray-300">Protocol Comparison</h4>
								<canvas id="protocol-comparison-chart"></canvas>
							</div>
							<div class="bg-light-gray rounded-lg p-6">
								<h4 class="text-sm font-semibold mb-4 text-gray-300">Top Servers by Latency</h4>
								<canvas id="server-comparison-chart"></canvas>
							</div>
							<div class="bg-light-gray rounded-lg p-6">
								<h4 class="text-sm font-semibold mb-4 text-gray-300">Success Rate Trend</h4>
								<canvas id="success-rate-chart"></canvas>
							</div>
						</div>
					</div>
				</div>

				<!-- Welcome Message -->
				<div id="welcome-message" class="flex items-center justify-center h-full">
					<div class="text-center space-y-4">
						<h2 class="text-3xl font-bold text-electric-blue">Welcome to goDnsBench</h2>
						<p class="text-gray-400">Select protocols and servers from the sidebar, then click "Run Benchmark" to start</p>
					</div>
				</div>
			</div>
		</main>
	</div>

	<!-- Hidden file input for server import -->
	<input type="file" id="import-file-input" accept=".json,.csv" class="hidden" />

	<!-- Settings Modal -->
	<div id="settings-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
		<div class="bg-light-gray rounded-lg p-6 w-full max-w-2xl max-h-[90vh] overflow-y-auto border border-lighter-gray">
			<div class="flex items-center justify-between mb-6">
				<h2 class="text-2xl font-bold text-neon-cyan">Settings</h2>
				<button id="settings-close-btn" class="text-gray-400 hover:text-white text-2xl">&times;</button>
			</div>

			<div class="space-y-6">
				<!-- Timeout -->
				<div>
					<label for="settings-timeout" class="block text-sm font-semibold text-gray-300 mb-2">
						Query Timeout (milliseconds)
					</label>
					<input
						type="number"
						id="settings-timeout"
						min="100"
						max="10000"
						step="100"
						value="1000"
						class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white focus:outline-none focus:border-electric-blue"
					/>
				</div>

				<!-- Concurrency -->
				<div>
					<label for="settings-concurrency" class="block text-sm font-semibold text-gray-300 mb-2">
						Max Concurrent Servers
					</label>
					<input
						type="number"
						id="settings-concurrency"
						min="1"
						max="50"
						value="10"
						class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white focus:outline-none focus:border-electric-blue"
					/>
				</div>

				<!-- Protocols -->
				<div>
					<label class="block text-sm font-semibold text-gray-300 mb-2">
						Enabled Protocols
					</label>
					<div class="space-y-2">
						<label class="flex items-center space-x-2 cursor-pointer">
							<input type="checkbox" id="settings-protocol-dns" checked class="form-checkbox text-electric-blue">
							<span>DNS (UDP/TCP)</span>
						</label>
						<label class="flex items-center space-x-2 cursor-pointer">
							<input type="checkbox" id="settings-protocol-doh" checked class="form-checkbox text-electric-blue">
							<span>DoH (HTTPS)</span>
						</label>
						<label class="flex items-center space-x-2 cursor-pointer">
							<input type="checkbox" id="settings-protocol-dot" checked class="form-checkbox text-electric-blue">
							<span>DoT (TLS)</span>
						</label>
						<label class="flex items-center space-x-2 cursor-pointer">
							<input type="checkbox" id="settings-protocol-doq" checked class="form-checkbox text-electric-blue">
							<span>DoQ (QUIC)</span>
						</label>
					</div>
				</div>

				<!-- Test Domains -->
				<div>
					<label class="block text-sm font-semibold text-gray-300 mb-2">
						Test Domains
					</label>
					<div class="space-y-4">
						<div>
							<label for="settings-domains-a" class="block text-xs text-gray-400 mb-1">
								A Records (one per line)
							</label>
							<textarea
								id="settings-domains-a"
								rows="3"
								class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm focus:outline-none focus:border-electric-blue font-mono"
								placeholder="google.com&#10;cloudflare.com&#10;amazon.com"
							></textarea>
						</div>
						<div>
							<label for="settings-domains-mx" class="block text-xs text-gray-400 mb-1">
								MX Records (one per line)
							</label>
							<textarea
								id="settings-domains-mx"
								rows="2"
								class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm focus:outline-none focus:border-electric-blue font-mono"
								placeholder="gmail.com&#10;microsoft.com"
							></textarea>
						</div>
						<div>
							<label for="settings-domains-txt" class="block text-xs text-gray-400 mb-1">
								TXT Records (one per line)
							</label>
							<textarea
								id="settings-domains-txt"
								rows="2"
								class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm focus:outline-none focus:border-electric-blue font-mono"
								placeholder="_dmarc.google.com&#10;google.com"
							></textarea>
						</div>
						<div>
							<label for="settings-domains-dnssec" class="block text-xs text-gray-400 mb-1">
								DNSSEC Domains (one per line)
							</label>
							<textarea
								id="settings-domains-dnssec"
								rows="2"
								class="w-full px-4 py-2 bg-dark-gray border border-lighter-gray rounded text-white text-sm focus:outline-none focus:border-electric-blue font-mono"
								placeholder="cloudflare.com&#10;google.com"
							></textarea>
						</div>
					</div>
				</div>

				<!-- Buttons -->
				<div class="flex justify-end space-x-3 pt-4 border-t border-lighter-gray">
					<button id="settings-cancel-btn" class="px-6 py-2 bg-lighter-gray hover:bg-gray-600 rounded transition">
						Cancel
					</button>
					<button id="settings-save-btn" class="px-6 py-2 bg-electric-blue hover:bg-neon-cyan text-white font-semibold rounded transition">
						Save
					</button>
				</div>
			</div>
		</div>
	</div>

	<script src="../scripts/init.ts"></script>
</Layout>

<style is:global>
	.form-checkbox {
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 0.25rem;
		border-color: #4b5563;
		background-color: #1e1e1e;
	}

	.form-checkbox:checked {
		background-color: #0066ff;
		border-color: #0066ff;
	}
</style>
